{
  "name": "flowlab",
  "private": true,
  "type": "module",
  "description": "FlowLab - 2D incompressible Navier-Stokes solver with a validated benchmark suite.",
  "scripts": {
    "test": "node --test tests/*.js",
    "serve": "node scripts/serve.js",
    "validate": "node scripts/generate-validation-doc.js",
    "golden": "node scripts/generate-golden-fields.js",
    "browser": "node --test tests/browser/*.js",
    "verify": "npm test && npm run browser"
  }
}
